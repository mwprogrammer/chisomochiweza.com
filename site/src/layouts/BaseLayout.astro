---
import '../styles/global.css'
import { Image } from 'astro:assets';
import Profile from "../assets/profile.png" 
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Chisomo Chiweza</title>
	</head>
	<body class="bg-[#FAF8FF]">
		<header class="flex justify-between items-center p-4 shadow-xs border-b-amber-50 text-sm">
			<div class="flex items-center">
				<Image src={Profile} alt="An avatar image of Chisomo Chiweza." class={"h-8 w-8 rounded-full"} />
				<p class="mx-4 font-semibold text-[#3A485B]">Chisomo Chiweza</p>
				<p class="mx-4 font-semibold text-[#604100]">SOFTWARE ENGINEER</p>
			</div>
			<nav class="text-[#604100]">
				<a href="/" class="mx-4 hover:text-[#281900] p-1 px-2 rounded-md underline underline-offset-4">HOME</a>
				<a href="/about/" class="mx-4 hover:text-[#281900]">ABOUT</a>
				<a href="/portfolio/" class="mx-4 hover:text-[#281900]">PORTFOLIO</a>
				<a href="/writing/" class="mx-4  hover:text-[#281900]">WRITING</a>
			</nav>
			<nav>
				<a href="https://github.com/mwprogrammer" target="_blank" class="mx-2 font-bold text-[#8392A8] hover:text-[#3A485B]"> GITHUB</a>
				<span class="mx-2 font-bold text-[#FDBA45]">/</span>
				<a href="https://mw.linkedin.com/in/chisomochiweza" target="_blank" class="mx-2 font-bold text-[#8392A8] hover:text-[#3A485B]"> LINKEDIN</a>
				<span class="mx-2 font-bold text-[#FDBA45]">/</span>
				<a href="https://bsky.app/profile/chisomochiweza.com" target="_blank" class="mx-2 font-bold text-[#8392A8] hover:text-[#3A485B]"> BLUESKY</a>
			</nav>
		</header>
		<main class="h-screen">
			<slot />
		</main>
		<footer></footer>
	</body>
</html>
